<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13+ notifications runtime permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Network access for Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Storage permissions for downloading files -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Biometric authentication permission -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".CareerConnectApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CareerConnect"
        tools:targetApi="31">
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />

        <!-- Splash Activity (no longer launcher) -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="false"
            android:theme="@style/Theme.CareerConnect" />

        <!-- Registration Activity -->
        <activity
            android:name=".ui.authentication.RegistrationActivity"
            android:exported="false"
            android:theme="@style/Theme.CareerConnect" />

        <!-- Login Activity - Entry point -->
        <activity
            android:name=".ui.authentication.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.CareerConnect">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Forgot Password Activity -->
        <activity
            android:name=".ui.authentication.ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.CareerConnect" />

        <!-- Profile Completion Activity -->
        <activity
            android:name=".ui.profile.ProfileCompletionActivity"
            android:exported="false"
            android:theme="@style/Theme.CareerConnect" />

        <!-- Main Activity -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.CareerConnect" />

        <!-- Settings Activity -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.CareerConnect" />

        <!-- Change Password Activity -->
        <activity
            android:name=".ui.settings.ChangePasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.CareerConnect" />

        <!-- Edit Profile Activity -->
        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.CareerConnect" />

        <!-- Job Posting Activity (Recruiters) -->
        <activity
            android:name=".ui.recruiter.JobPostingActivity"
            android:exported="false"
            android:theme="@style/Theme.CareerConnect" />

        <!-- All Jobs Activity (Job Seekers) -->
        <activity
            android:name=".ui.jobseeker.AllJobsActivity"
            android:exported="false"
            android:theme="@style/Theme.CareerConnect" />

        <!-- Job Details Activity -->
        <activity
            android:name=".ui.jobseeker.JobDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.CareerConnect" />

        <!-- Job Application Activity -->
        <activity
            android:name=".ui.jobseeker.JobApplicationActivity"
            android:exported="false"
            android:theme="@style/Theme.CareerConnect" />

        <!-- Bookmarked Jobs Activity -->
        <activity
            android:name=".ui.jobseeker.BookmarkedJobsActivity"
            android:exported="false"
            android:theme="@style/Theme.CareerConnect" />

        <!-- Job Applications Activity (Recruiters) -->
        <activity
            android:name=".ui.recruiter.JobApplicationsActivity"
            android:exported="false"
            android:theme="@style/Theme.CareerConnect" />

        <!-- Recruiter Job Applications List Activity -->
        <activity
            android:name=".ui.recruiter.RecruiterJobApplicationsActivity"
            android:exported="false"
            android:theme="@style/Theme.CareerConnect" />
        <!-- CV Viewer Activity -->
        <activity
            android:name=".ui.recruiter.CVViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.CareerConnect" />

        <!-- Firebase Messaging Service for handling push notifications -->
        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- FileProvider for sharing files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>